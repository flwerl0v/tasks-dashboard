# Copy this file to .env and fill in your Supabase project credentials
# (Project Settings -> API in the Supabase dashboard).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: URL of the deployed "ai-summary" Supabase Edge Function.
# Leave empty to fall back to a locally computed heuristic summary.
VITE_AI_SUMMARY_ENDPOINT=
